;; Records to ADD to openheartapp.org
;; Cloudflare > DNS > Records > Import and export > Import DNS records
;; Nothing here replaces an existing record. All 6 are new.
;;
;; Proxy status must be DNS only (grey cloud) for every one of them.

;; --- 1-3. Proves to inboxes that SES may sign mail for us (DKIM)
uxn74szn2o6zjqfbi5gwgsrkz2hly32l._domainkey.send.openheartapp.org.	300	IN	CNAME	uxn74szn2o6zjqfbi5gwgsrkz2hly32l.dkim.amazonses.com.
6lhbmdhfacesc7autfwlbxu6plclfgkg._domainkey.send.openheartapp.org.	300	IN	CNAME	6lhbmdhfacesc7autfwlbxu6plclfgkg.dkim.amazonses.com.
k47josnffd2kcjd33i6nk3goczcsdp2z._domainkey.send.openheartapp.org.	300	IN	CNAME	k47josnffd2kcjd33i6nk3goczcsdp2z.dkim.amazonses.com.

;; --- 4-5. Where bounces go, and who may send (SES)
bounce.send.openheartapp.org.	300	IN	MX	10 feedback-smtp.eu-central-1.amazonses.com.
bounce.send.openheartapp.org.	300	IN	TXT	"v=spf1 include:amazonses.com ~all"

;; --- 6. Who may send as openheartapp.org (Google Workspace). You have
;;     none today, which is why your own mail is unauthenticated.
openheartapp.org.	300	IN	TXT	"v=spf1 include:_spf.google.com ~all"

;; --- 7. Reporting only, changes nothing about delivery yet
_dmarc.openheartapp.org.	300	IN	TXT	"v=DMARC1; p=none; rua=mailto:aadesh@openheartapp.org"
