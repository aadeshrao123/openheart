# Copy to .env - never commit .env
#
# EXPO_PUBLIC_* is compiled into the client bundle and is readable by anyone
# who downloads the app. That is fine for these three values and fatal for any
# other. The Supabase service-role key and the R2 secret belong in Supabase
# Edge Function secrets, never here.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_IMAGE_BASE_URL=
