{
  "expo": {
    "name": "OpenHeart",
    "slug": "openheart",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "openheart",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "OpenHeart needs your photos so you can add them to your profile."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Shows you people nearby. Stored rounded to about 1km."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
