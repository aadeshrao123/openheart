# Private planning notes. Roadmap, decision log, open questions. Not for the
# public repo: they contain unmade decisions and half-formed plans that would
# read as commitments to anyone browsing.
MY_DOCS/

# Local agent configuration.
# Deliberately not tracked: every contributor should be free to run whatever
# tooling and rules they prefer. Project standards that everyone must follow
# belong in CLAUDE.md and docs/, which ARE tracked.
.claude/

# Secrets
.env
.env.local
.env.*.local

# Dependencies
node_modules/
.pnpm-store/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native builds
ios/
android/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Generated
lib/database.types.ts

# Written by `deno test` over supabase/functions. --node-modules-dir=auto makes
# Deno read the root package.json, so it locks the whole React Native tree, none
# of which the functions use. Their one npm import is version-pinned in the
# specifier itself, so there is nothing here worth keeping.
deno.lock

# Local code-graph tooling, same reasoning as .claude/
.code-review-graph/

# Supabase local
supabase/.branches/
supabase/.temp/

# Editors
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
