# Generated
lib/database.types.ts

# Written by `deno test` over supabase/functions. --node-modules-dir=auto makes
# Deno read the root package.json, so it locks the whole React Native tree, none
# of which the functions use. Their one npm import is version-pinned in the
# specifier itself, so there is nothing here worth keeping.
deno.lock

# Local code-graph tooling, same reasoning as .claude/
.code-review-graph/

# Supabase local
supabase/.branches/
supabase/.temp/

# Editors
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# The Google Play service account key, which eas.json points at by name. Play
# will not issue a second one for the same account, so a leak means revoking
# and re-inviting the account rather than rotating a string. Checked with
# git check-ignore against this exact path before the file was ever created,
# which is the check .env.production needed and did not get.
play-service-account.json
*-service-account.json

# The Firebase Android config. Firebase documents it as safe to check in, and
# that is true of the file's contents: it is a project id and an API key that
# identifies rather than authorises, and this project has no Authentication and
# no data services behind it.
#
# It is ignored anyway. GitHub's secret scanner flags the key on sight and
# cannot see any of that context, so a public repository carrying one collects
# an alert that has to be dismissed rather than fixed, and a dismissed alert is
# a worse habit than an ignored file. A fork should also be pointing at its own
# Firebase project rather than registering its users' devices against this one.
#
# Needed for a local Android build. See SETUP.md.
google-services.json
